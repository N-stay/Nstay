  "text": {
    "ko": {
      "title": "N STAY에 오신 것을 환영합니다",
      "sub": "보수동 책방골목과 부평깡통시장 바로 앞 안락한 숙소",
      "intro": "숙소 이용 방법, 와이파이, 대중교통, 추천 맛집 및 관광지 안내를 한곳에서 확인하세요.",
      "sections": [
        {
          "menu": "숙소 안내",
          "title": "숙소 안내",
          "items": [
            {
              "b": "입구 및 보안",
              "p": "외출 시 도어록이 완전히 닫히고 잠겼는지 꼭 확인해주세요."
            },
            {
              "b": "조용한 시간 (Quiet Hours)",
              "p": "22:00 ~ 08:00에는 이웃 주민을 위해 큰 소음이나 음악을 삼가주세요."
            },
            {
              "b": "금연 안내",
              "p": "실내 전체는 절대 금연 구역입니다 (전자담배 포함)."
            }
          ]
        },
        {
          "menu": "Wi-Fi",
          "title": "Wi-Fi 안내",
          "items": [
            {
              "b": "접속 정보",
              "p": "숙소 내 초고속 인터넷이 무료로 제공됩니다. 아래 비밀번호를 확인해주세요."
            }
          ]
        },
        {
          "menu": "교통 & 정류장",
          "title": "대중교통 & 버스 정류장",
          "items": [
            {
              "b": "가까운 버스 정류장",
              "p": "도보 2~3분 거리에 '보수사거리' 및 '부평시장' 정류장이 위치해 있습니다."
            },
            {
              "b": "주요 버스 노선",
              "p": "부산역(81, 40, 103번), 서면/전포(81번 직통 약 25분), 해운대(1003번 급행)."
            },
            {
              "b": "지하철 (도시철도)",
              "p": "부산 1호선 '자갈치역' 3번 출구 또는 '토성역'에서 도보 약 7~9분 거리입니다."
            },
            {
              "b": "부산역 이동 팁",
              "p": "부산역까지 택시로 약 10분 소요되며(기본요금 수준), 버스로도 환승 없이 이동 가능합니다."
            }
          ]
        },
        {
          "menu": "주변 추천 맛집",
          "title": "호스트 추천 주변 맛집",
          "items": [
            {
              "b": "맛집 거리 안내",
              "p": "부평깡통시장 야시장, 족발골목, 전통 돼지국밥, 밀면 노포가 모두 도보권에 있습니다."
            }
          ]
        },
        {
          "menu": "부산 명소 & 근교",
          "title": "부산 명소 & 추천 여행지",
          "items": [
            {
              "b": "원도심 도보 코스",
              "p": "보수동 책방골목 → 부평깡통시장 → 국제시장 → BIFF광장 → 자갈치시장 (도보권)"
            },
            {
              "b": "동부산 및 카페거리",
              "p": "전포 카페거리, 광안리 해변, 해운대 블루라인파크까지 환승 또는 직통 교통편이 편리합니다."
            }
          ]
        },
        {
          "menu": "에어컨 & 리모컨",
          "title": "에어컨 & 리모컨",
          "items": [
            {
              "b": "에어컨 사용법",
              "p": "리모컨 POWER 버튼 → COOL(냉방) 모드 → 적정 온도(24~26도) 설정"
            },
            {
              "b": "외출 시 주의",
              "p": "외출 시에는 에너지 절약과 안전을 위해 에어컨과 조명을 반드시 꺼주세요."
            }
          ]
        },
        {
          "menu": "주방",
          "title": "주방 안내",
          "items": [
            {
              "b": "인덕션 조리",
              "p": "사용 후 전원을 끄고 상판 잔열에 주의하세요. 조리 중 자리를 비우지 마세요."
            },
            {
              "b": "식기 및 조리기구",
              "p": "사용하신 식기는 설거지 후 원래 자리에 정돈 부탁드립니다."
            },
            {
              "b": "전자레인지",
              "p": "은박지 및 금속 용기는 화재 위험이 있으니 절대 넣지 마세요."
            }
          ]
        },
        {
          "menu": "욕실 & 온수사용",
          "title": "욕실 & 온수 사용법",
          "items": [
            {
              "b": "온수 사용",
              "p": "벽면에 위치한 보일러 조절기에서 '온수전용' 또는 '난방/온수' 버튼이 켜져 있는지 확인 후 사용해주세요."
            },
            {
              "b": "배수 관리",
              "p": "배수구가 막히지 않도록 머리카락이나 이물질은 휴지통에 버려주세요."
            }
          ]
        },
        {
          "menu": "세탁 안내",
          "title": "세탁 안내 (코인세탁방)",
          "items": [
            {
              "b": "위치",
              "p": "숙소 바로 앞에 코인세탁방이 있습니다. 도보 1분 거리이며, 아래 지도 버튼으로 위치를 확인하실 수 있습니다."
            },
            {
              "b": "이용 방법",
              "p": "세탁기와 건조기를 모두 이용할 수 있습니다. 동전 또는 카드로 결제하며, 세제는 현장에서 구매할 수 있습니다."
            }
          ]
        },
        {
          "menu": "쓰레기 분리수거",
          "title": "쓰레기 & 분리수거",
          "items": [
            {
              "b": "일반 쓰레기",
              "p": "제공된 종량제 봉투에 담아 입구를 묶어주세요."
            },
            {
              "b": "재활용 분리수거",
              "p": "플라스틱, 캔, 유리병, 종이는 물로 헹군 후 분리해주세요."
            },
            {
              "b": "음식물 쓰레기",
              "p": "물기를 최대한 뺀 후 싱크대 전용 음식물 쓰레기통에 담아주세요."
            }
          ]
        },
        {
          "menu": "안전",
          "title": "안전 & 응급상황",
          "items": [
            {
              "b": "응급 연락처",
              "p": "화재/구급 119, 범죄/도난 112"
            },
            {
              "b": "비상 장비",
              "p": "현관 및 주방 인근 소화기와 비상 대피 경로를 미리 확인해두세요."
            }
          ]
        },
        {
          "menu": "배달 안내",
          "title": "배달 음식 안내",
          "items": [
            {
              "b": "배달 주소",
              "p": "배달 주문 시 아래 3층 주소를 그대로 입력해 주세요."
            },
            {
              "b": "배달앱 사용",
              "p": "외국인 게스트는 배달의민족 글로벌(영문) 페이지를 간편하게 이용할 수 있습니다."
            }
          ]
        },
        {
          "menu": "체크아웃",
          "title": "체크아웃 안내",
          "items": [
            {
              "b": "체크아웃 시간",
              "p": "오전 11:00까지 퇴실을 완료해주세요."
            },
            {
              "b": "퇴실 전 점검",
              "p": "에어컨/난방 OFF, 전등 소등, 창문 및 문 잠김 확인 후 에어비앤비 메시지로 알려주세요."
            }
          ]
        },
        {
          "menu": "Airbnb 문의",
          "title": "Airbnb 문의",
          "items": [
            {
              "b": "문의 방식",
              "p": "머무시는 동안 문의사항이 있으시면 언제든지 에어비앤비 메시지로 연락 주세요."
            }
          ]
        }
      ]
    },
    "en": {
      "title": "Welcome to N STAY",
      "sub": "Cozy stay near Bosu-dong Book Street & Bupyeong Market",
      "intro": "Instructions for house rules, Wi-Fi, transit, recommended restaurants, and Busan travel guide.",
      "sections": [
        {
          "menu": "House Guide",
          "title": "House Guide",
          "items": [
            {
              "b": "Entrance & Lock",
              "p": "Please ensure the electronic door lock is securely locked whenever leaving."
            },
            {
              "b": "Quiet Hours",
              "p": "Please keep noise low between 22:00 and 08:00 for the neighbors."
            },
            {
              "b": "No Smoking",
              "p": "Strictly no smoking inside the premises (including e-cigarettes)."
            }
          ]
        },
        {
          "menu": "Wi-Fi",
          "title": "Wi-Fi Info",
          "items": [
            {
              "b": "High-speed Wi-Fi",
              "p": "Free high-speed Wi-Fi is available. Check the password below."
            }
          ]
        },
        {
          "menu": "Transit & Bus",
          "title": "Transit & Bus Stops",
          "items": [
            {
              "b": "Nearby Bus Stops",
              "p": "2~3 mins walk to 'Bosu Intersection' or 'Bupyeong Market' bus stop."
            },
            {
              "b": "Key Bus Lines",
              "p": "Busan Station (No. 81, 40, 103), Seomyeon/Jeonpo (No. 81 direct, ~25m), Haeundae (No. 1003 express)."
            },
            {
              "b": "Subway (Metro)",
              "p": "Approx. 7~9 mins walk to Jagalchi Station or Toseong Station (Line 1)."
            },
            {
              "b": "Taxi Fare",
              "p": "Only about 10 mins by taxi from Busan KTX Station (~₩5,000-6,000)."
            }
          ]
        },
        {
          "menu": "Local Food",
          "title": "Recommended Local Food",
          "items": [
            {
              "b": "Food Alleys",
              "p": "Bupyeong Night Market street foods, Jokbal alley, pork soup, and Milmyeon are all within walking distance."
            }
          ]
        },
        {
          "menu": "Busan Highlights",
          "title": "Busan Highlights & Day Trips",
          "items": [
            {
              "b": "Walking Route",
              "p": "Bosu Book Alley → Bupyeong Night Market → Gukje Market → BIFF Square → Jagalchi Market."
            },
            {
              "b": "Trendy & Beaches",
              "p": "Easily reach Jeonpo Cafe Street, Gwangalli Beach, and Haeundae via bus or subway."
            }
          ]
        },
        {
          "menu": "AC & Remote",
          "title": "Air Conditioning & Remote",
          "items": [
            {
              "b": "How to Use",
              "p": "Press POWER → Select COOL mode ❄️ → Set to 24~26°C."
            },
            {
              "b": "Energy Saving",
              "p": "Please turn off the AC and lights whenever you step out."
            }
          ]
        },
        {
          "menu": "Kitchen",
          "title": "Kitchen & Cooking",
          "items": [
            {
              "b": "Induction Cooktop",
              "p": "Turn off after cooking. Beware of hot surface."
            },
            {
              "b": "Dishes",
              "p": "Please wash used cookware/dishes and return them to the shelf."
            },
            {
              "b": "Microwave",
              "p": "Never heat aluminum foil or metalware in the microwave."
            }
          ]
        },
        {
          "menu": "Bathroom & Hot Water",
          "title": "Bathroom & Hot Water",
          "items": [
            {
              "b": "Hot Water",
              "p": "Please ensure the 'Hot Water (온수)' mode is active on the boiler wall controller before showering."
            },
            {
              "b": "Drain Care",
              "p": "Do not flush wet wipes or hair down the drain."
            }
          ]
        },
        {
          "menu": "Laundry",
          "title": "Laundry (Coin Laundromat)",
          "items": [
            {
              "b": "Location",
              "p": "A self-service coin laundromat is right in front of the building, about a 1 minute walk. Tap the map button below for directions."
            },
            {
              "b": "How to Use",
              "p": "Both washers and dryers are available. Pay by coin or card; detergent can be purchased on site."
            }
          ]
        },
        {
          "menu": "Trash & Recycle",
          "title": "Trash & Recycling",
          "items": [
            {
              "b": "General Waste",
              "p": "Use the designated trash bag provided."
            },
            {
              "b": "Recycling",
              "p": "Rinse and separate plastic bottles, cans, glass, and paper."
            },
            {
              "b": "Food Waste",
              "p": "Drain moisture completely and place in the small food waste bin."
            }
          ]
        },
        {
          "menu": "Safety",
          "title": "Safety & Emergency",
          "items": [
            {
              "b": "Emergency Lines",
              "p": "Fire & Medical: 119 | Police: 112"
            },
            {
              "b": "Safety Gear",
              "p": "Fire extinguisher is placed near the entrance/kitchen."
            }
          ]
        },
        {
          "menu": "Food Delivery",
          "title": "Food Delivery",
          "items": [
            {
              "b": "Delivery Address",
              "p": "Please use the 3rd floor address below when ordering food."
            },
            {
              "b": "Baemin Global",
              "p": "Order directly in English using Baemin Global web/app."
            }
          ]
        },
        {
          "menu": "Check-out",
          "title": "Check-out",
          "items": [
            {
              "b": "Check-out Time",
              "p": "Please complete check-out by 11:00 AM."
            },
            {
              "b": "Before Leaving",
              "p": "Turn off AC/lights, close windows, lock the door, and send us a message on Airbnb."
            }
          ]
        },
        {
          "menu": "Airbnb Contact",
          "title": "Airbnb Contact",
          "items": [
            {
              "b": "Contact Host",
              "p": "Feel free to message us on Airbnb anytime during your stay!"
            }
          ]
        }
      ]
    },
    "ja": {
      "title": "N STAYへようこそ",
      "sub": "宝水洞本屋通りと富平カントン市場すぐそばの快適な宿",
      "intro": "宿泊案内、Wi-Fi、交通アクセス、おすすめグルメ、釜山観光案内をまとめています。",
      "sections": [
        {
          "menu": "宿泊案内",
          "title": "宿泊案内",
          "items": [
            {
              "b": "施錠の確認",
              "p": "外出時は電子ロックが確実に施錠されているかご確認ください。"
            },
            {
              "b": "静かな時間",
              "p": "22:00〜08:00の間は近隣への配慮のため静かにお過ごしください。"
            },
            {
              "b": "完全禁煙",
              "p": "電子タバコを含め室内は完全禁煙です。"
            }
          ]
        },
        {
          "menu": "Wi-Fi",
          "title": "Wi-Fi案内",
          "items": [
            {
              "b": "接続情報",
              "p": "高速無料Wi-Fiをご利用いただけます。以下をご確認ください。"
            }
          ]
        },
        {
          "menu": "交通・バス",
          "title": "公共交通・バス停",
          "items": [
            {
              "b": "最寄りのバス停",
